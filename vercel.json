{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" },
    { "src": "api/run-column.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/run-column", "dest": "/api/run-column.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
